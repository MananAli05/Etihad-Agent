GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Outbound calling agent. Lets the post-call webhook tell a follow-up call
# apart from a new website caller, so attribution is not overwritten.
ELEVENLABS_OUTBOUND_AGENT_ID=

# Post-call webhook signing secret from the ElevenLabs dashboard.
# Leave blank to skip signature verification (development only).
ELEVENLABS_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:5173

# Supabase (CRM persistence).
# The service_role key is required: RLS blocks the anon/publishable key from
# writing to chat_history. Find it under Project Settings -> API -> service_role.
# Never expose this key to the browser - backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lead alert emails. Any SMTP provider works; Gmail needs an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not the normal account password. Leave blank to turn alerts off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_ALERT_TO=

# Used in the alert's "Open in CRM" link.
ADMIN_URL=https://etihad-admin.vercel.app
